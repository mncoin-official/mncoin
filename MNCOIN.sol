// File: MNCOIN-10.12.25.sol


pragma solidity ^0.8.25;

/**
 * @title MNCOIN — Final Enterprise Token (Launch & Upgrade Ready)
 * @notice Designed for secure launch on BSC + future multi-chain expansion.
