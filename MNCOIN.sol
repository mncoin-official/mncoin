interface IPancakeRouter {
    function factory() external pure returns (address);
    function WETH() external pure returns (address);
    function getAmountsOut(uint256 amountIn, address[] calldata path) external view returns (uint256[] memory amounts);
    function swapExactTokensForTokensSupportingFeeOnTransferTokens(
        uint256 amountIn,
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external;
    function addLiquidity(
        address tokenA,
        address tokenB,
        uint256 amountADesired,
        uint256 amountBDesired,
        uint256 amountAMin,
        uint256 amountBMin,
        address to,
        uint256 deadline
    ) external returns (uint256 amountA, uint256 amountB, uint256 liquidity);
}

// =============== Custom Errors ===============
error ZeroAddress();
error ZeroAmount();
error FeeSumTooLarge();
error TradingNotEnabled();
error CooldownActive();
error TxTooLarge();
error WalletTooLarge();
error RouterOrQuoteNotSet();
error InsufficientBNB();
error RecoverOwnToken();
error SlippageTooLarge();
error PriceImpactTooHigh();
error UpgradeDelayNotMet();
error NotAuthorized();
error InvalidImplementation();
error SwapCircuitBreakerActive();

// =============== Main Contract ===============
contract MNCOIN is
    ERC20Upgradeable,
    Ownable2StepUpgradeable,
    UUPSUpgradeable,
    ReentrancyGuardUpgradeable,
    PausableUpgradeable,
    ERC165Upgradeable
{
    using SafeERC20Upgradeable for IERC20Upgradeable;
    using AddressUpgradeable for address;

    // =============== Constants ===============
    uint8 public constant DECIMALS = 18;
    uint256 public constant DECIMALS_FACTOR = 1e18;
    uint256 public constant TOTAL_SUPPLY = 300_100_000_000 * DECIMALS_FACTOR;
    uint256 public constant MINING_RESERVED = 100_000_000 * DECIMALS_FACTOR; // reserved for community mining
    uint256 public constant AUTO_BURN_CAP = 20_000_000_000 * DECIMALS_FACTOR;
    uint256 public constant FEE_DENOM = 10_000;
    uint256 public constant UPGRADE_DELAY = 24 hours;
    uint256 public constant MAX_SWAP_FAILURES = 5;
    uint16 public constant MAX_PRICE_IMPACT_BPS = 1500; // 15%

    // =============== Fees ===============
    uint16 public burnFeeBps;
    uint16 public liquidityFeeBps;
    uint16 public treasuryFeeBps;
    uint16 public devFeeBps;
    uint16 public totalFeeBps;

    // =============== Wallets ===============
    address public treasuryWallet;
    address public liquidityWallet;
    address public devWallet;
    address public constant BURN_ADDRESS = 0x000000000000000000000000000000000000dEaD;

    // =============== Router & Tokens ===============
    IPancakeRouter public router;
    address public quoteToken;
    address public pairAddress; // optional pair address (set after addLiquidity)

    // =============== Trading Controls ===============
    bool public tradingEnabled;
    uint256 public launchBlock;
    uint256 public antiBotBlocks;
    uint256 public maxTxAmount;
    uint256 public maxWallet;
    mapping(address => bool) public isExcludedFromFees;
    mapping(address => bool) public isExcludedFromLimits;
    mapping(address => bool) public automatedMarketMakerPairs;

    // =============== CEX Handling ===============
    mapping(address => bool) public isCEX;

    // =============== Cooldown ===============
    mapping(address => uint256) public lastTxTimestamp;
    bool public cooldownEnabled;
    uint256 public cooldownSeconds;

    // =============== Swap & Liquidity ===============
    bool private inSwap;
    uint256 public swapThreshold;
    bool public swapEnabled;
    uint16 public swapSlippageBps;
    uint256 public maxSwapAmount;

    // =============== Security ===============
    uint256 public burnedAutoTotal;
    uint256 public consecutiveSwapFailures;
    bool public swapCircuitBreaker;

    // =============== Upgrade Timelock ===============
    address public upgradeTimelock;
    address public pendingImplementation;
    uint256 public upgradeRequestTime;

    // =============== Mining reserve (NEW) ===============
    // We will hold the reserved tokens inside the token contract (address(this))
    // and only allow a designated miningEngine contract to distribute them to the community.
    address public miningEngine;
    uint256 public miningDistributed; // total distributed so far from the reserve

    // =============== Internal Flags ===============
    bool private _inFeeTransfer;

    // =============== Events ===============
    event FeesUpdated(uint16 burn, uint16 liq, uint16 treasury, uint16 dev);
    event WalletsUpdated(address treasury, address liquidity, address dev);
    event TradingEnabled(uint256 launchBlock);
    event ExcludeFromFees(address indexed account, bool excluded);
    event ExcludeFromLimits(address indexed account, bool excluded);
    event SwapAndLiquify(uint256 tokensSwapped, uint256 quoteReceived, uint256 liqTokens);
    event BurnAuto(address indexed from, uint256 amount);
    event BurnManual(address indexed by, uint256 amount);
    event SwapCircuitBreakerActivated();
    event SwapCircuitReset();
    event UpgradeRequested(address implementation, uint256 timestamp);
    event UpgradeTimelockSet(address timelock);
    event PairSet(address pair);
    event AutomatedMarketMakerPairSet(address pair, bool value);
    event SwapSettingsUpdated(bool enabled, uint256 threshold, uint16 slippage);
    event CooldownUpdated(bool enabled, uint256 seconds_);
    event MaxThresholdsUpdated(uint256 maxTx, uint256 maxWallet, uint256 maxSwap);
    event FeesProcessed(uint256 tokensProcessed, uint256 quoteReceived);
    event CEXSet(address indexed account, bool status);

    // NEW events for mining reserve
    event MiningEngineSet(address indexed engine);
    event MiningDistributed(address indexed to, uint256 amount);

    modifier lockTheSwap() {
        inSwap = true;
        _;
        inSwap = false;
    }

    modifier onlyMiningEngine() {
        if (msg.sender != miningEngine) revert NotAuthorized();
        _;
    }

    // =============== Initialization ===============
    /// @notice Initialize with 0% fees for clean deployment
    function initialize(
        address _owner,
        address _treasury,
        address _liquidity,
        address _dev,
        address _router,
        address _quoteToken
    ) public initializer {
        if (_owner == address(0) || _treasury == address(0) || _liquidity == address(0) || _router == address(0) || _quoteToken == address(0))
            revert ZeroAddress();

        __ERC20_init("MNCOIN", "MN8642COIN");
        __Ownable_init(_owner);
        __Ownable2Step_init();
        __UUPSUpgradeable_init();
        __ReentrancyGuard_init();
        __Pausable_init();
        __ERC165_init();

        treasuryWallet = _treasury;
        liquidityWallet = _liquidity;
        devWallet = _dev == address(0) ? _owner : _dev;
        router = IPancakeRouter(_router);
        quoteToken = _quoteToken;

        // Start with 0% fees and unlimited transfers for clean launch
        burnFeeBps = 0;
        liquidityFeeBps = 0;
        treasuryFeeBps = 0;
        devFeeBps = 0;
        totalFeeBps = 0;

        maxTxAmount = TOTAL_SUPPLY;
        maxWallet = TOTAL_SUPPLY;
        swapThreshold = (TOTAL_SUPPLY * 5) / 100_000;
        maxSwapAmount = TOTAL_SUPPLY;
        antiBotBlocks = 0; // Will be set in enableTrading
        cooldownEnabled = false;
        cooldownSeconds = 20;
        swapEnabled = true;
        swapSlippageBps = 500;

        // mint entire supply to owner
        _mint(_owner, TOTAL_SUPPLY);

        // Exclude key addresses
        _setExcludedFromFees(_owner, true);
        _setExcludedFromFees(address(this), true);
        _setExcludedFromFees(treasuryWallet, true);
        _setExcludedFromFees(liquidityWallet, true);

        _setExcludedFromLimits(_owner, true);
        _setExcludedFromLimits(address(this), true);
        _setExcludedFromLimits(treasuryWallet, true);
        _setExcludedFromLimits(liquidityWallet, true);

        // Reserve MINING_RESERVED tokens by transferring from owner to this contract
        // These tokens stay here until a miningEngine is set and allowed to distribute them
        if (MINING_RESERVED > 0) {
            // transfer reserved tokens into the contract's balance
            super._transfer(_owner, address(this), MINING_RESERVED);
        }

        upgradeTimelock = _owner;
    }

    function decimals() public pure override returns (uint8) {
        return DECIMALS;
    }

    function supportsInterface(bytes4 interfaceId) public view virtual override(ERC165Upgradeable) returns (bool) {
        return interfaceId == type(IERC20Upgradeable).interfaceId || super.supportsInterface(interfaceId);
    }

    // =============== Transfers ===============
    function transfer(address to, uint256 amount) public override whenNotPaused returns (bool) {
        _transferWithFees(_msgSender(), to, amount);
        return true;
    }

    function transferFrom(address from, address to, uint256 amount) public override whenNotPaused returns (bool) {
        _spendAllowance(from, _msgSender(), amount);
        _transferWithFees(from, to, amount);
        return true;
    }

    function _transferWithFees(address from, address to, uint256 amount) internal {
        if (from == address(0) || to == address(0)) revert ZeroAddress();
        if (amount == 0) {
            super._transfer(from, to, 0);
            return;
        }

        if (!isExcludedFromLimits[from] && !isExcludedFromLimits[to]) {
            if (!tradingEnabled) revert TradingNotEnabled();
            if (block.number <= launchBlock + antiBotBlocks) {
                if (amount > maxTxAmount / 2 || balanceOf(to) + amount > maxWallet / 2)
                    revert TxTooLarge();
            }
            if (amount > maxTxAmount || balanceOf(to) + amount > maxWallet)
                revert TxTooLarge();

            if (cooldownEnabled) {
                address subject = automatedMarketMakerPairs[from] ? to : from;
                uint256 last = lastTxTimestamp[subject];
                if (last != 0 && block.timestamp < last + cooldownSeconds)
                    revert CooldownActive();
                lastTxTimestamp[subject] = block.timestamp;
            }
        }

        if (
            swapEnabled &&
            !inSwap &&
            !isExcludedFromFees[from] &&
            !isExcludedFromFees[to] &&
            !automatedMarketMakerPairs[from] &&
            balanceOf(address(this)) >= swapThreshold
        ) {
            _processFeesAccumulated(balanceOf(address(this)));
        }

        // If either side is a registered CEX deposit/withdraw wallet, skip transfer fees to avoid CEX compatibility issues
        bool cexTransfer = isCEX[from] || isCEX[to];

        bool takeFee = !isExcludedFromFees[from] && !isExcludedFromFees[to] && totalFeeBps > 0 && !_inFeeTransfer && !cexTransfer;
        if (!takeFee) {
            super._transfer(from, to, amount);
            return;
        }

        (uint256 burnAmt, uint256 liqAmt, uint256 treasuryAmt, uint256 devAmt) = _calcFees(amount);
        uint256 feeTotal = burnAmt + liqAmt + treasuryAmt + devAmt;
        uint256 sendAmount = amount - feeTotal;

        _inFeeTransfer = true;
        super._transfer(from, to, sendAmount);

        if (burnAmt > 0) {
            if (burnedAutoTotal + burnAmt > AUTO_BURN_CAP) {
                burnAmt = burnedAutoTotal >= AUTO_BURN_CAP ? 0 : AUTO_BURN_CAP - burnedAutoTotal;
            }
            if (burnAmt > 0) {
                super._transfer(from, BURN_ADDRESS, burnAmt);
                _burn(BURN_ADDRESS, burnAmt);
                burnedAutoTotal += burnAmt;
                emit BurnAuto(from, burnAmt);
            }
        }

        uint256 otherFees = liqAmt + treasuryAmt + devAmt;
        if (otherFees > 0) {
            super._transfer(from, address(this), otherFees);
        }

        _inFeeTransfer = false;
    }

    // ✅ FIXED: renamed return parameters to avoid naming conflict
    function _calcFees(uint256 amount) internal view returns (uint256 outBurn, uint256 outLiq, uint256 outTreasury, uint256 outDev) {
        outBurn = (amount * burnFeeBps) / FEE_DENOM;
        outLiq = (amount * liquidityFeeBps) / FEE_DENOM;
        outTreasury = (amount * treasuryFeeBps) / FEE_DENOM;
        outDev = (amount * devFeeBps) / FEE_DENOM;
    }

    // =============== Swap Logic ===============
    function _processFeesAccumulated(uint256 balance) internal nonReentrant lockTheSwap {
        if (balance == 0 || swapCircuitBreaker) return;

        uint256 amountToProcess = maxSwapAmount > 0 && balance > maxSwapAmount ? maxSwapAmount : balance;
        if (amountToProcess == 0) return;

        uint256 totalFeeParts = liquidityFeeBps + treasuryFeeBps + devFeeBps;
        if (totalFeeParts == 0) {
            super._transfer(address(this), liquidityWallet, amountToProcess);
            return;
        }

        uint256 tokensForLiq = (amountToProcess * liquidityFeeBps) / totalFeeParts;
        uint256 tokensForFees = amountToProcess - tokensForLiq;
        uint256 halfLiq = tokensForLiq / 2;
        uint256 tokensToSwap = tokensForFees + halfLiq;

        uint256 quoteReceived = _swapTokensForQuote(tokensToSwap);
        if (quoteReceived == 0) {
            super._transfer(address(this), liquidityWallet, amountToProcess);
            return;
        }

        uint256 quoteForLiq = halfLiq > 0 ? (quoteReceived * halfLiq) / tokensToSwap : 0;
        uint256 quoteForFees = quoteReceived - quoteForLiq;

        if (halfLiq > 0 && quoteForLiq > 0) {
            _addLiquidity(halfLiq, quoteForLiq);
            emit SwapAndLiquify(tokensToSwap, quoteReceived, halfLiq);
        }

        if (quoteForFees > 0) {
            uint256 denom = treasuryFeeBps + devFeeBps;
            if (denom == 0) {
                IERC20Upgradeable(quoteToken).safeTransfer(treasuryWallet, quoteForFees);
            } else {
                uint256 treasuryShare = (quoteForFees * treasuryFeeBps) / denom;
                uint256 devShare = quoteForFees - treasuryShare;
                if (treasuryShare > 0) IERC20Upgradeable(quoteToken).safeTransfer(treasuryWallet, treasuryShare);
                if (devShare > 0) IERC20Upgradeable(quoteToken).safeTransfer(devWallet, devShare);
            }
        }

        emit FeesProcessed(amountToProcess, quoteReceived);
    }

    function _swapTokensForQuote(uint256 tokenAmount) internal returns (uint256) {
        if (address(router) == address(0) || quoteToken == address(0) || quoteToken == address(this))
            revert RouterOrQuoteNotSet();

        address[] memory path = new address[](2);
        path[0] = address(this);
        path[1] = quoteToken;

        _approve(address(this), address(router), tokenAmount);

        uint256 expectedOut;
        try router.getAmountsOut(tokenAmount, path) returns (uint256[] memory amounts) {
            expectedOut = amounts[1];
            if (expectedOut == 0) {
                _recordSwapFailure();
                return 0;
            }
        } catch {
            _recordSwapFailure();
            return 0;
        }

        if (swapSlippageBps >= FEE_DENOM) revert SlippageTooLarge();
        uint256 amountOutMin = (expectedOut * (FEE_DENOM - swapSlippageBps)) / FEE_DENOM;

        // price impact guard using pair reserves if available
        if (pairAddress != address(0)) {
            uint256 reserveQuote = IERC20Upgradeable(quoteToken).balanceOf(pairAddress);
            if (reserveQuote > 0 && expectedOut > 0) {
                uint256 impactBps = (expectedOut * FEE_DENOM) / reserveQuote;
                if (impactBps > MAX_PRICE_IMPACT_BPS) revert PriceImpactTooHigh();
            }
        }

        uint256 balanceBefore = IERC20Upgradeable(quoteToken).balanceOf(address(this));
        try router.swapExactTokensForTokensSupportingFeeOnTransferTokens(
            tokenAmount,
            amountOutMin,
            path,
            address(this),
            block.timestamp + 300
        ) {
            uint256 balanceAfter = IERC20Upgradeable(quoteToken).balanceOf(address(this));
            uint256 received = balanceAfter > balanceBefore ? balanceAfter - balanceBefore : 0;
            if (received > 0) consecutiveSwapFailures = 0;
            return received;
        } catch {
            _recordSwapFailure();
            return 0;
        }
    }

    function _recordSwapFailure() private {
        consecutiveSwapFailures++;
        if (consecutiveSwapFailures >= MAX_SWAP_FAILURES) {
            swapCircuitBreaker = true;
            emit SwapCircuitBreakerActivated();
        }
    }

    function _addLiquidity(uint256 tokenAmount, uint256 quoteAmount) internal {
        _approve(address(this), address(router), tokenAmount);
        IERC20Upgradeable(quoteToken).safeApprove(address(router), quoteAmount);
        router.addLiquidity(
            address(this),
            quoteToken,
            tokenAmount,
            quoteAmount,
            0,
            0,
            liquidityWallet,
            block.timestamp + 300
        );
    }

    // =============== Manual Burn ===============
    function burn(uint256 amount) external whenNotPaused {
        if (amount == 0) revert ZeroAmount();
        _burn(_msgSender(), amount);
        emit BurnManual(_msgSender(), amount);
    }

    function burnFrom(address account, uint256 amount) external whenNotPaused {
        if (amount == 0) revert ZeroAmount();
        _spendAllowance(account, _msgSender(), amount);
        _burn(account, amount);
        emit BurnManual(_msgSender(), amount);
    }

    // =============== Admin Controls ===============
    /// @notice Enable trading AND auto-configure all security & fee settings for public launch
    function enableTrading() external onlyOwner {
        require(!tradingEnabled, "Trading already enabled");

        tradingEnabled = true;
        launchBlock = block.number;
        antiBotBlocks = 3;

        //  AUTO-ENABLE FEES & SECURITY ON LAUNCH
        burnFeeBps = 200;       // 2%
        liquidityFeeBps = 150;  // 1.5%
        treasuryFeeBps = 150;   // 1.5%
        devFeeBps = 100;        // 1%
        totalFeeBps = 600;      // 6%

        maxTxAmount = (TOTAL_SUPPLY * 3) / 1000;   // 0.3%
        maxWallet = (TOTAL_SUPPLY * 5) / 1000;     // 0.5%
        swapThreshold = (TOTAL_SUPPLY * 5) / 100_000; // 0.005%
        maxSwapAmount = (TOTAL_SUPPLY * 30) / 10_000; // 0.3%
        cooldownEnabled = true;
        cooldownSeconds = 20;

        emit TradingEnabled(launchBlock);
        emit FeesUpdated(burnFeeBps, liquidityFeeBps, treasuryFeeBps, devFeeBps);
        emit MaxThresholdsUpdated(maxTxAmount, maxWallet, maxSwapAmount);
        emit CooldownUpdated(cooldownEnabled, cooldownSeconds);
    }

    function setUpgradeTimelock(address _timelock) external onlyOwner {
        if (_timelock == address(0)) revert ZeroAddress();
        upgradeTimelock = _timelock;
        emit UpgradeTimelockSet(_timelock);
    }

    function requestUpgrade(address newImplementation) external onlyOwner {
        if (newImplementation == address(0)) revert ZeroAddress();
        pendingImplementation = newImplementation;
        upgradeRequestTime = block.timestamp;
        emit UpgradeRequested(newImplementation, upgradeRequestTime);
    }

    function cancelUpgrade() external onlyOwner {
        pendingImplementation = address(0);
        upgradeRequestTime = 0;
    }

    function resetCircuitBreaker() external onlyOwner {
        swapCircuitBreaker = false;
        consecutiveSwapFailures = 0;
        emit SwapCircuitReset();
    }

    function updateFees(uint16 _burn, uint16 _liq, uint16 _treasury, uint16 _dev) external onlyOwner {
        uint16 sum = _burn + _liq + _treasury + _dev;
        if (sum > FEE_DENOM) revert FeeSumTooLarge();
        burnFeeBps = _burn;
        liquidityFeeBps = _liq;
        treasuryFeeBps = _treasury;
        devFeeBps = _dev;
        totalFeeBps = sum;
        emit FeesUpdated(_burn, _liq, _treasury, _dev);
    }

    function updateWallets(address _treasury, address _liquidity, address _dev) external onlyOwner {
        if (_treasury == address(0) || _liquidity == address(0)) revert ZeroAddress();
        treasuryWallet = _treasury;
        liquidityWallet = _liquidity;
        devWallet = _dev == address(0) ? owner() : _dev;
        emit WalletsUpdated(_treasury, _liquidity, devWallet);
    }

    function setExcludedFromFees(address account, bool excluded) external onlyOwner {
        _setExcludedFromFees(account, excluded);
        emit ExcludeFromFees(account, excluded);
    }

    function _setExcludedFromFees(address account, bool excluded) internal {
        isExcludedFromFees[account] = excluded;
    }

    function setExcludedFromLimits(address account, bool excluded) external onlyOwner {
        _setExcludedFromLimits(account, excluded);
        emit ExcludeFromLimits(account, excluded);
    }

    function _setExcludedFromLimits(address account, bool excluded) internal {
        isExcludedFromLimits[account] = excluded;
    }

    function setRouterAndQuote(address _router, address _quote) external onlyOwner {
        if (_router == address(0) || _quote == address(0)) revert ZeroAddress();
        router = IPancakeRouter(_router);
        quoteToken = _quote;
    }

    function setPairAddress(address _pair) external onlyOwner {
        pairAddress = _pair;
        emit PairSet(_pair);
    }

    function setAutomatedMarketMakerPair(address pair, bool value) external onlyOwner {
        automatedMarketMakerPairs[pair] = value;
        emit AutomatedMarketMakerPairSet(pair, value);
    }

    function setSwapSettings(bool _enabled, uint256 _threshold, uint16 _slippage) external onlyOwner {
        if (_slippage >= FEE_DENOM) revert SlippageTooLarge();
        swapEnabled = _enabled;
        swapThreshold = _threshold;
        swapSlippageBps = _slippage;
        emit SwapSettingsUpdated(_enabled, _threshold, _slippage);
    }

    function setMaxThresholds(uint256 _maxTx, uint256 _maxWallet, uint256 _maxSwap) external onlyOwner {
        maxTxAmount = _maxTx;
        maxWallet = _maxWallet;
        maxSwapAmount = _maxSwap;
        emit MaxThresholdsUpdated(_maxTx, _maxWallet, _maxSwap);
    }

    function setCooldown(bool _enabled, uint256 _seconds) external onlyOwner {
        cooldownEnabled = _enabled;
        cooldownSeconds = _seconds;
        emit CooldownUpdated(_enabled, _seconds);
    }

    function recoverERC20(address token, address to, uint256 amount) external onlyOwner {
        if (token == address(this)) revert RecoverOwnToken();
        IERC20Upgradeable(token).safeTransfer(to, amount);
    }

    function emergencyWithdrawBNB(address payable to, uint256 amount) external onlyOwner {
        if (amount > address(this).balance) revert InsufficientBNB();
        AddressUpgradeable.sendValue(to, amount);
    }

    // =============== Manual trigger for fees (owner) ===============
    function processFeesNow(uint256 minTokensToProcess) external onlyOwner nonReentrant {
        uint256 bal = balanceOf(address(this));
        if (bal >= minTokensToProcess && bal > 0) {
            _processFeesAccumulated(bal);
        }
    }

    // =============== CEX helpers ===============
    function setCEX(address account, bool status) external onlyOwner {
        isCEX[account] = status;
        emit CEXSet(account, status);
    }

    function setCEXBulk(address[] calldata accounts, bool status) external onlyOwner {
        for (uint256 i = 0; i < accounts.length; ++i) {
            isCEX[accounts[i]] = status;
            emit CEXSet(accounts[i], status);
        }
    }

    // =============== Mining reserve admin ===============
    /// @notice Set the mining engine contract that is allowed to distribute reserved tokens
    function setMiningEngine(address _engine) external onlyOwner {
        if (_engine == address(0)) revert ZeroAddress();
        miningEngine = _engine;
        emit MiningEngineSet(_engine);
    }

    /// @notice Called by the miningEngine to distribute reserved tokens to community participants
    /// The miningEngine must implement its own fair distribution logic off-chain/on-chain.
    function distributeFromReserve(address to, uint256 amount) external nonReentrant onlyMiningEngine {
        if (amount == 0) revert ZeroAmount();
        uint256 remaining = miningReserveRemaining();
        require(amount <= remaining, "exceeds reserved amount");

        miningDistributed += amount;
        super._transfer(address(this), to, amount);
        emit MiningDistributed(to, amount);
    }

    function miningReserveRemaining() public view returns (uint256) {
        if (MINING_RESERVED <= miningDistributed) return 0;
        return MINING_RESERVED - miningDistributed;
    }

    // =============== UUPS Upgrade ===============
    function _authorizeUpgrade(address newImplementation) internal view override {
        if (msg.sender != upgradeTimelock) revert NotAuthorized();
        if (pendingImplementation != newImplementation) revert InvalidImplementation();
        if (upgradeRequestTime == 0 || block.timestamp < upgradeRequestTime + UPGRADE_DELAY)
            revert UpgradeDelayNotMet();
    }

    // =============== Helpers ===============
    //  FIXED: renamed return parameters
    function getFeeBreakdown() external view returns (uint16 outBurn, uint16 outLiq, uint16 outTreasury, uint16 outDev, uint16 outTotal) {
        return (burnFeeBps, liquidityFeeBps, treasuryFeeBps, devFeeBps, totalFeeBps);
    }

    function canAutoBurnRemaining() external view returns (uint256) {
        if (burnedAutoTotal >= AUTO_BURN_CAP) return 0;
        return AUTO_BURN_CAP - burnedAutoTotal;
    }

    // allow contract to receive BNB (e.g., from router refunds)
    receive() external payable {}

    uint256[500] private __gap;
}
